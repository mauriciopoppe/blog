{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.mauriciopoppe.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
